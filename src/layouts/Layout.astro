---
import "../styles/global.css"
interface Props {
  title?: string
  description?: string
}
const {
  title = "Andrew Kodkod — Engineering Manager / Tech Lead",
  description = "Andrew Kodkod. Engineering Manager and Tech Lead building web, mobile and desktop products since 2007."
} = Astro.props
const home = Astro.url.pathname === "/"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <meta
      name="color-scheme"
      content="light dark"
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="skip-link"
      href="#main"
    >
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="wordmark"
          href="/"
          aria-label="Andrew Kodkod, home"
        >
          <span aria-hidden="true">[</span> akodkod <span aria-hidden="true">]</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/#portfolio">work</a>
          <a href="/#skills">skills</a>
          <a href="/#testimonials">kind words</a>
          <a href="/#contact-me">contact</a>
        </nav>
      </header>
      <main
        id="main"
        class:list={[!home && "document-page"]}
      >
        {!home && (
          <a
            class="back-link"
            href="/"
          >
            ← back to index
          </a>
        )}
        <slot />
      </main>
      <footer class="site-footer">
        <span>Andrew Kodkod · since 2007</span>
        <a href="#main">back to top ↑</a>
      </footer>
    </div>
  </body>
</html>
