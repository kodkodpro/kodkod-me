---
import { Image } from "astro:assets"
import avatar from "../../assets/images/avatar.jpg"
import { GraphStat } from "../../registry/default/graph-stat/graph-stat"
import { Callout } from "../../registry/default/callout/callout"
---

<section
  class="hero"
  aria-labelledby="intro-title"
>
  <p class="eyebrow">
    <span aria-hidden="true">~/</span> a little about me
  </p>
  <div class="intro-identity">
    <Image
      src={avatar}
      alt="Andrew Kodkod"
      width={112}
      height={112}
      densities={[1, 2]}
      class="portrait"
      loading="eager"
    />
    <div>
      <h1 id="intro-title">Andrew Kodkod<span class="cursor" aria-hidden="true">_</span></h1>
      <p class="role">Engineering Manager / Tech Lead</p>
    </div>
  </div>
  <div class="intro-copy">
    <p>I build apps and lead development teams.</p>
    <p>
      I’ve worked on web, mobile and desktop apps, including multi-million dollar projects. Having run a business
      myself, I understand the decisions and trade-offs behind the work.
    </p>
  </div>
  <div class="intro-links">
    <a href="#portfolio">explore my work ↓</a>
    <a href="mailto:andrew@kodkod.me">say hello ↗</a>
  </div>
  <GraphStat
    title="in numbers"
    className="intro-stats"
    items={[
      { value: "15+", label: "years of experience" },
      { value: "50+", label: "projects built" },
      { value: "10", label: "team members", hint: "maximum team size" }
    ]}
  />
  <Callout
    title="current status"
    className="availability"
  >
    <p>Not available for hire. Always happy to exchange ideas.</p>
  </Callout>
</section>
