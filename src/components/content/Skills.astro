---
import { skills } from "../../data/skills"
import { GraphSpec } from "../../registry/default/graph-spec/graph-spec"
---

<section
  id="skills"
  class="section"
  aria-labelledby="skills-heading"
>
  <div class="section-heading">
    <span aria-hidden="true">02 /</span>
    <h2 id="skills-heading">Tools & experience</h2>
    <span class="section-note">a working reference</span>
  </div>
  <div class="skills-grid">
    {skills.map(({ section, items }) => (
      <GraphSpec
        title={section}
        rows={items.map(({ name, note }) => ({ label: name, value: note }))}
      />
    ))}
  </div>
</section>
