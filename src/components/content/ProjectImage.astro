---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
interface Props {
  src: ImageMetadata
  alt: string
  href: string
  eager?: boolean
  compact?: boolean
}
const { src, alt, href, eager = false, compact = false } = Astro.props
---

<figure class:list={["project-image", compact && "project-logo"]}>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Open full-size image: ${alt}`}
  >
    <Image
      src={src}
      alt={alt}
      width={1000}
      densities={[1, 2]}
      loading={eager ? "eager" : "lazy"}
    />
  </a>
  <figcaption>
    {alt}
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      full size ↗
    </a>
  </figcaption>
</figure>
