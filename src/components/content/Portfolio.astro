---
import { projects } from "../../data/portfolio"
---

<section
  id="portfolio"
  class="section"
  aria-labelledby="work-heading"
>
  <div class="section-heading">
    <span aria-hidden="true">01 /</span>
    <h2 id="work-heading">Selected work</h2>
    <span class="section-note">web + mobile</span>
  </div>
  <p class="section-intro">A few of the products I’ve helped build over the years.</p>
  <ol class="project-list">
    {projects.map((project, index) => (
      <li>
        <span
          class="project-number"
          aria-hidden="true"
        >
          0{index + 1}
        </span>
        <div>
          <h3>
            <a href={project.url}>
              {project.title.replace(" Web & Mobile App", "")}
              <span aria-hidden="true"> ↗</span>
            </a>
          </h3>
          <p>{project.tagline}</p>
          <p class="project-meta">
            {project.role}
            <span aria-hidden="true"> / </span>
            {project.duration}
          </p>
        </div>
        <a
          class="project-open"
          href={project.url}
          aria-label={`Read ${project.title} case study`}
        >
          [ read ]
        </a>
      </li>
    ))}
  </ol>
</section>
