---
import { contactMethods } from "../../data/contactme"
---

<section
  id="contact-me"
  class="section contact"
  aria-labelledby="contact-heading"
>
  <div class="section-heading">
    <span aria-hidden="true">04 /</span>
    <h2 id="contact-heading">Keep in touch</h2>
  </div>
  <p>Have a question, an interesting problem, or just want to chat?</p>
  <a
    class="email-link"
    href="mailto:andrew@kodkod.me"
  >
    andrew@kodkod.me <span aria-hidden="true">↗</span>
  </a>
  <div class="social-links">
    {contactMethods
      .filter((m) => m.label !== "Email")
      .map(({ label, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {label} <span aria-hidden="true">↗</span>
        </a>
      ))}
  </div>
</section>
