---
import { getImage } from "astro:assets"
import jeff from "../../assets/images/people/jeff.jpg"
import edward from "../../assets/images/people/edward.jpg"
import rob from "../../assets/images/people/rob.jpg"
import { testimonials } from "../../data/testimonials"
import { Quote } from "../../registry/default/quote/quote"
import { marked } from "marked"
const portraits = await Promise.all(
  [jeff, edward, rob].map((src) => getImage({ src, width: 96, height: 96, format: "webp" }))
)
---

<section
  id="testimonials"
  class="section"
  aria-labelledby="testimonials-heading"
>
  <div class="section-heading">
    <span aria-hidden="true">03 /</span>
    <h2 id="testimonials-heading">Kind words</h2>
    <span class="section-note">people I’ve worked with</span>
  </div>
  <div class="quotes">
    {testimonials.map(({ text, name, title }, index) => (
      <Quote
        by={name}
        source={title}
        avatar={{ src: portraits[index].src, alt: name }}
      >
        <Fragment set:html={marked(text)} />
      </Quote>
    ))}
  </div>
</section>
